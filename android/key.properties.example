# Copia questo file in android/key.properties (escluso da git) per firmare
# le versioni ufficiali. NON caricare mai key.properties o il file .jks su GitHub.
#
# Per creare la chiave (una sola volta, poi conservala al sicuro):
#   keytool -genkey -v -keystore ~/ritmo-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias ritmo
#
storePassword=la-password-del-keystore
keyPassword=la-password-della-chiave
keyAlias=ritmo
storeFile=/percorso/assoluto/ritmo-release.jks
